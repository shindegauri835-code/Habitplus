@font-face { font-family: "Monaspace Argon"; font-style: normal; font-weight: 200 800; font-display: swap; src: url("/font/MonaspaceArgonVarVF[wght,wdth,slnt].woff2") format("woff2"); font-variation-settings: "wght" 300, "wdth" 100, "slnt" 1; font-feature-settings: "calt", "ss01", "ss02", "ss03", "liga"; }

a {
  color: var(--text-color-1); outline: none; text-decoration: none;
  &:hover { text-decoration: none; }
}

input, textarea, select, kbd { font-family: var(--font-base); }

button { color: inherit; font: inherit; background: 0px 0px; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; padding: 0px; }

select { cursor: pointer; }

body, div, dl, dt, dd, ul, ol, li, h1, h2, h3, h4, h5, h6, pre, form, fieldset, input, textarea, p, blockquote, th, td { margin: 0px; padding: 0px; }

table { border-collapse: collapse; border-spacing: 0px; }

fieldset, img { border: 0px; }

address, caption, cite, code, dfn, em, strong, th, var { font-style: normal; font-weight: 400; }

ol, ul { list-style: none; }

caption, th { text-align: left; }

h1, h2, h3, h4, h5, h6 { font-size: 100%; font-weight: 400; }

abbr, acronym { border: 0px; }

::placeholder { color: var(--input-placeholder); }

.icon { stroke: inherit; }

button:focus, a:focus, a:active { outline: none !important; }

.checkboxCont {
  cursor: pointer;
  & .checkbox {
  background: var(--input-bg); vertical-align: middle; border-radius: 20px; width: 32px; height: 18px; margin-right: 5px; transition: 0.15s; display: inline-block; position: relative; top: -2px;
  &::after { content: ""; background: var(--border-color-5); border-radius: 16px; width: 14px; height: 14px; transition: 0.15s; display: block; position: absolute; top: 2px; left: 2px; }
}
  & input[type="checkbox"] {
  display: none;
  &:checked + .checkbox {
  background: var(--common-accent);
  &::after { background: rgb(255, 255, 255); left: 16px; }
}
  &:disabled + .checkbox {
  background: rgba(0, 0, 0, 0.1);
  &::after { opacity: 0.5; }
}
}
  & small { color: rgba(0, 0, 0, 0.3); font-size: inherit; }
}

.proBadgeSelf { background: var(--input-bg-focus); text-transform: uppercase; color: var(--text-color-3); border-radius: 4px; padding: 2px 4px; font-size: 8px; font-weight: 600; display: inline-block; }

.groupsList {
  flex-wrap: wrap; margin: 3px 0px 15px; display: flex;
  & label {
  background: var(--input-bg); color: inherit; white-space: nowrap; cursor: pointer; border-radius: 6px; align-items: center; margin: 3px; padding: 3px 6px; display: flex;
  & input { display: none; }
  &:has(input:checked) { background: var(--common-accent); }
}
  & .privateGroup {
  height: 10px; margin-right: 5px;
  & g { stroke: var(--text-color-3); }
}
}

#flash-messages {
  z-index: 100; opacity: 1; will-change: opacity, transform; pointer-events: auto; justify-content: center; transition: 0.2s; display: flex; position: fixed; top: 85px; left: 0px; right: 0px;
  & li { height: 60px; color: var(--tooltip-text-color); cursor: pointer; background: var(--modal-bg-color); backdrop-filter: blur(10px) brightness(2.7); box-shadow: 0px 8px 16px 0px var(--tooltip-shadow-color), 0px 0px 1px 0px var(--tooltip-shadow-border); border-radius: 100px; align-items: center; padding: 0px 30px; font-weight: 500; display: flex; }
  & svg { height: 30px; margin-right: 20px; }
}

.pseudoAvatar { background: var(--text-color-accent-6); color: rgba(0, 0, 0, 0.6); width: 35px; height: 35px; box-shadow: inset 0 0 0 1px var(--common-border-5); text-transform: uppercase; border-radius: 100%; justify-content: center; align-items: center; font-size: 10px; font-weight: 900; animation: 290s ease 0s infinite normal none running fa-author-colors; display: flex; }

.input {
  width: 100%; height: 34px; color: var(--text-color-1); font-family: var(--font-base); background: var(--input-bg); box-sizing: border-box; vertical-align: middle; appearance: none; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; border-radius: 6px; outline: none; padding: 0px 8px; font-size: 13px;
  &:focus-visible { box-shadow: 0 0 0 2px var(--common-accent); }
}

.input_small { height: 28px; font-size: 12px; }

@keyframes fa-author-colors { 
  0% { background-color: var(--text-color-accent-6); }
  10% { background-color: var(--text-color-accent-8); }
  30% { background-color: var(--text-color-accent-2); }
  50% { background-color: var(--text-color-accent-1); }
  70% { background-color: var(--text-color-accent-7); }
  90% { background-color: var(--text-color-accent-8); }
  100% { background-color: var(--text-color-accent-3); }
}

html { height: 100vh; }

body { height: 100vh; font-family: var(--font-base); background: var(--body-bg); color: var(--text-color-1); font-optical-sizing: auto; font-variation-settings: "slnt" 0; font-size: 14px; font-style: normal; overflow: hidden; }

body.noSidebar {
  & #fiddle-info {
  left: 10px;
  & .sidebarToggle { margin-right: 2px; }
}
  & #sidebar-main {
  & .sidebarItem .toggler {
  justify-content: center;
  & svg { margin-right: 0px; }
  & span { display: none; }
}
}
  & #sidebar-user {
  padding: 15px 10px;
  & .suInfo { justify-content: center; }
  & em { display: none; }
  & .pseudoAvatar { margin-right: 0px; }
  & .commonActions { display: none; }
}
  & #apps {
  & h4 { text-align: center; padding: 0px; }
  & a {
  justify-content: center;
  & span { display: none; }
}
  & svg { margin-right: 0px; }
}
  & #layout-container { grid-template-columns: 75px 1fr; }
}

.seoTitle, #sidebar h2 { opacity: 0; position: absolute; top: -1000px; }

#progressbar { z-index: 110; pointer-events: none; height: 3px; position: absolute; top: 66px; left: 0px; right: 0px; }

#layout-container #header { border-bottom: solid 1px var(--common-border); height: 65px; position: relative; }

#layout-container { grid-template-columns: 250px 1fr; grid-template-areas: "sidebar header" "sidebar content"; height: 100vh; display: grid; position: relative; }

html.hasJs .ssrContent { display: none; }

.modalBody { background-color: rgba(0, 0, 0, 0); display: none; }

#header { grid-area: header; grid-template-columns: 1fr auto; min-height: 65px; display: grid; }

#fiddle-info { display: none; }

#content { grid-area: content; position: relative; }

#sidebar {
  background: var(--sidebar-bg); grid-template: "." 66px "." 1fr "." "." / 1.2fr; grid-area: sidebar; gap: 0px; margin: 0px; padding: 0px; display: grid; position: relative;
  & h1 {
  box-sizing: border-box; border-bottom: solid 1px var(--common-border);
  & a { align-items: center; width: 60px; height: 65px; padding-left: 15px; display: flex; }
  & svg { width: 46px; height: 33px; stroke: var(--common-accent); }
}
}

#sidebar-main, #sidebar-user, .headerActions { display: none; }

body.darkMode {
  & #switch-theme {
  & .isDark { display: block; }
  & .isLight { display: none; }
}
}

#switch-theme {
  & .isDark { display: none; }
  & .isLight { display: block; }
}
