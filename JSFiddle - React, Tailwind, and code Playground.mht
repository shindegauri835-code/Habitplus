#carbon-responsive ::after, #carbon-responsive ::before { all: revert; }

#carbon-responsive { --carbon-padding: 1em; --carbon-max-char: 20ch; --carbon-bg-primary: #fafafa; --carbon-bg-secondary: #ebebeb; --carbon-text-color: #333; display: flex; flex-flow: column wrap; font-family: system-ui, sans-serif; font-size: 14px; gap: 1ex; line-height: 1.5; max-inline-size: 400px; min-inline-size: 130px; }

#carbon-responsive .carbon-responsive-wrap { background-color: var(--carbon-bg-primary); border: 1px solid var(--carbon-bg-secondary); display: flex; flex-wrap: wrap; gap: var(--carbon-padding); padding: var(--carbon-padding); }

#carbon-responsive .carbon-responsive-wrap-bg { border-width: medium; border-style: none; border-color: currentcolor; border-image: none; overflow: hidden; position: relative; }

#carbon-responsive .carbon-responsive-wrap-bg::after, #carbon-responsive .carbon-responsive-wrap-bg::before { content: ""; inset: 0px; position: absolute; }

#carbon-responsive .carbon-responsive-wrap-bg::before { background-position: 50% center; background-repeat: no-repeat; background-size: cover; z-index: 0; }

#carbon-responsive .carbon-responsive-wrap-bg::after { backdrop-filter: blur(8px); z-index: 1; }

#carbon-responsive .carbon-responsive-wrap-bg > * { z-index: 2; }

#carbon-responsive .carbon-responsive-wrap-bg, #carbon-responsive .carbon-responsive-wrap-bg a, #carbon-responsive .carbon-responsive-wrap-bg a:hover { color: rgb(255, 255, 255); }

#carbon-responsive a { text-decoration: none; }

#carbon-responsive a, #carbon-responsive a:hover { color: var(--carbon-text-color); }

#carbon-responsive .carbon-img { flex: 0 0 130px; }

#carbon-responsive .carbon-img img { display: block; }

#carbon-responsive .carbon-img img[width="130"] { height: 100px; width: 130px; }

#carbon-responsive .carbon-img-large { flex: 0 0 100px; }

#carbon-responsive .carbon-img-large img { height: 100px; object-fit: cover; width: 100px; }

#carbon-responsive .carbon-logo { display: block; flex-shrink: 0; height: 30px; width: auto; }

#carbon-responsive .carbon-tagline { display: block; font-weight: 600; line-height: 1.3; }

#carbon-responsive .carbon-img-large ~ .carbon-text { font-size: 0.85em; }

#carbon-responsive .carbon-text { flex-basis: var(--carbon-max-char); flex-grow: 1; line-height: 1.4; text-align: left; }

#carbon-responsive .carbon-responsive-wrap-bg .carbon-text { align-items: flex-start; display: flex; flex-direction: column; gap: 2px; }

#carbon-responsive .carbon-description { display: block; }

#carbon-responsive .carbon-poweredby { color: inherit; font-size: 0.85em; opacity: 0.5; text-align: right; }

@keyframes carbon-fade-in { 
  0% { opacity: 0; }
  100% { opacity: 1; }
}

#carbon-responsive { animation: 0.4s ease-out 0s 1 normal both running carbon-fade-in; }

#carbon-responsive.carbon-responsive--narrow .carbon-img, #carbon-responsive.carbon-responsive--narrow .carbon-img-large { flex: 0 0 100%; }

#carbon-responsive.carbon-responsive--narrow .carbon-img img, #carbon-responsive.carbon-responsive--narrow .carbon-img-large img { height: auto; width: 100%; }

#carbonads { position: relative; }

#carbon-responsive .carbon-poweredby { display: initial !important; }
